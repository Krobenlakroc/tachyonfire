//G1 is smith shadowing

//G2 is shadowing and masking


float BsdfNDot(vec3 a,vec3 b)
{
  return max(dot(a, b), 0.0);
}
float SmithGGXMasking(vec3 N,vec3 V,vec3 L, float a2)
{
    float dotNL = BsdfNDot(N,L);
    float dotNV = BsdfNDot(N,V);
    float denomC = sqrt(a2 + (1.0f - a2) * dotNV * dotNV) + dotNV;
    float mask = 2.0f * dotNV / max(denomC,0.0001);
    return mask*when_gt(denomC,0.0);
}

//====================================================================
float SmithGGXMaskingShadowing(vec3 N,vec3 V,vec3 L,  float a2)
{
  float dotNL = BsdfNDot(N,L);
  float dotNV = BsdfNDot(N,V);

    float denomA = dotNV * sqrt(a2 + (1.0f - a2) * dotNL * dotNL);
    float denomB = dotNL * sqrt(a2 + (1.0f - a2) * dotNV * dotNV);

    return 2.0f * dotNL * dotNV / max(denomA + denomB,0.00001);
}
 vec3 SchlickFresnel(vec3 r0, float rad)
{
    // -- The common Schlick Fresnel approximation
    float exponential = pow(1.0f - rad, 5.0f);
    return r0 + (1.0f - r0) * exponential;
}


vec4 traceCubes(uvec2 pixel_id,float depthval,vec3 position,vec3 normal,vec3 refnormal,float roughness,vec3 viewDir,float metal,int quality,vec3 F0,vec3 brdf,float synflag)
{
  float alpha = 1;
  float index = -1;
  float bounded = 0;//CheckCollision(position,EnvBoxMin[0],EnvBoxMax[0]);
  float cur_dist = -1;
  float closest_probe = 0;
  //float dist_2 = 1.0/0.0;//infinity :)

  ivec2 tile_id = ivec2((pixel_id.xy + 0.5/screenSize ) / vec2(screenSize.x/16.0,screenSize.y/8.0));
  uint cluster_slice_id = getClusterZIndex(depthval);

  uint tile_index = tile_id.x + tile_id.y*num_tiles_x + cluster_slice_id*num_tiles_x*num_tiles_y;

  uvec2 arr[2];
  arr[0] = offsets[tile_index/2 + (16*8*TH_Z_MEMORY)/2].xy;
  arr[1] = offsets[tile_index/2 + (16*8*TH_Z_MEMORY)/2].zw;
  uint count = arr[tile_index%2].y;
  uint offset = arr[tile_index%2].x;
  float fastNdotL = uintBitsToFloat(packHalf2x16(vec2(-1 ,1)));//dot(normal,refnormal);

    // return vec4(0,0,0,0);
  if (count ==0)
  {
    //outside simulation domain
    #ifdef STOCHASTIC_TRUE
    vec4 lookup_fast = textureLod(atmosphereCube,(refnormal*vec3(-1,1,1)),roughness*4.0);

    return vec4(lookup_fast.xyz*brdf,uintBitsToFloat(packHalf2x16(vec2(-1 ,-1))));
    #else
    vec4 lookup_fast = textureLod(atmosphereCube,(refnormal*vec3(-1,1,1)),roughness*4.0);

    return vec4(lookup_fast.xyz,fastNdotL);
    #endif

  }

  //smaller offset 10
  vec3 offsetpos = position + normal*10*synflag;//maybe use geormetry normal instead of normal mapped
//  vec3 position_bias = position + normal*100*synflag;//maybe use geormetry normal instead of normal mapped

  #ifdef USE_DIST_IN_CULL
  float dist_texs[32];
  float lod_defdepth_quicklookup = LOD_BIAS_QUICKLOOKUP;
  // float bias_quicklookup = -100;
    // float bias_quicklookup = -100;
    float bias_quicklookup = -10;
  for (int i = 0 ; i < count;i++)
  {
    uint a = offset + i;
    uint key =  acessbuffercubes[a/4][a%4];
    dist_texs[i] = textureLod(reflectionsDepth, vec4(normalize(offsetpos - EnvBoxPos[key].xyz)*vec3(-1,1,1),key),lod_defdepth_quicklookup).r;
  }
  #endif

  for (int i = 0 ; i < count;i++)
  {
    uint a = offset + i;
    uint key =  acessbuffercubes[a/4][a%4];

    #ifdef USE_DIST_IN_CULL
    float dist_tex = dist_texs[i];//textureLod(reflectionsDepth, vec4(normalize(offsetpos - EnvBoxPos[key])*vec3(-1,1,1),key),5.0).r;
    float cond = when_gt((dist_tex - sqrt(distance_squared(offsetpos,EnvBoxPos[key].xyz) ) ),bias_quicklookup);
    #else
    float cond = 1.0;
    #endif

    float factor_normal = when_gt(dot((EnvBoxPos[key].xyz - position),normal),0);
    //float bounded_i = cond*CheckCollision(position,EnvBoxMin[key] + vec3(100),EnvBoxMax[key] -vec3(100))*(factor_normal*synflag + (1.0-synflag));
    float bounded_i = cond*CheckCollision(position,EnvBoxMin[key].xyz + vec3(100),EnvBoxMax[key].xyz -vec3(100));//*(factor_normal*synflag + (1.0-synflag));
    float dist = distance_squared(position,EnvBoxPos[key].xyz);

    float replace = or(when_eq(index,-1),(1-when_eq(index,-1))*when_lt(dist,cur_dist) )*bounded_i;
    index = replace*key + (1-replace)*index;
    cur_dist = cur_dist*(1-replace) + dist*replace;//distance_squared(position,EnvBoxPos[int(index)]);

  }
  if (index == -1)
  {
    //no suitable cubemap
  //  vec4 lookup_fast = textureLod(atmosphereCube,(refnormal*vec3(-1,1,1)),roughness*4.0);
    return vec4(0,0,0,0);

  }


  #ifdef CUBEMAP_FAST
  vec4 lookup_fast = textureLod(reflections,vec4(refnormal*vec3(-1,1,1),index),roughness*4.0);
  //textureLod(reflections,vec4(refnormal*vec3(-1,1,1),index),roughness*4.0);//
  return vec4(lookup_fast.xyz*brdf,uintBitsToFloat(packHalf2x16(vec2(-1 ,-1))));
  #endif


  float dist_to_hit = 0;
  float occ = 1;

  vec3 l;

  #ifdef REALTIME_BDRF

  float metalfactor = 0;//when_eq(metal,0)*when_gt(roughness,0.5);

  const uint sample_count = 30 ;//+ uint(when_gt(roughness,0.2))*31;//uint(clamp(roughness*3,1,2));
  vec3 accum = vec3(0);
  float total_weight = 0;
  vec4 lookup;
  float h = 0;
  // roughness = 0.5;
  vec3 lu;


  float NdotL = -1;
  int iterations = 0;
  vec3 L;

  vec2 Xi = SampleRandomVector2D(uvec2(pixel_id.xy),iterations);//Hammersley(uint(noise*939) , 1001 );
  Xi.x = mix(Xi.x,0.0,0.2);
  if (roughness < 0.1)
  {
    Xi = vec2(0,0);
  }

  //vec3 H = ImportanceSampleGGX(Xi, normal, roughness);
  vec3 microsurface_normal = vec3(0);
  L =  -SampleReflectionVector(viewDir,normal,roughness,Xi,microsurface_normal);
  L = normalize(L);
  // L  = -reflect(viewDir, H);
  NdotL = dot(normal, -L);
  // iterations++;

  NdotL = max(NdotL,0);

  //  float coarse = raymarchCoarse(position,-L,reflectionsDepth,index,EnvBoxPos[int(index)]);
  vec4 lookup2;
  //  L = L*(1-metalfactor) + metalfactor*-refnormal;


  // int iters[] = {6,4,6};
  // int steps[] = {8,17,28};

  int iters[] = {6,4,6};
  int steps[] = {8,17,30};
  float h2 = raymarch(position,-L,index,EnvBoxPos[int(index)].xyz,lu,dist_to_hit,iters[quality - 1],steps[quality -1],synflag);//Hit((position - EnvBoxPos[int(index)]), refnormal, reflectionsDepth,index); // ray hit
  h2 = or(h2,when_lt(roughness,0.1)*(1 - synflag));


  //float cone = clamp(dist_to_hit/500,0,1)*roughness*roughness;
  lookup2 = textureLod(reflections,vec4(lu*vec3(-1,1,1),index),0.0);

  lookup2 = lookup2*h2 + textureLod(atmosphereCube,(-L*vec3(-1,1,1)),roughness*0.0)*(1-h2)*cube_nohit_sky;

  h = clamp(h + h2,0,1);

  #ifdef STOCHASTIC_TRUE
  NdotL = NdotL*(h2);// + (1-h2)*1;

  vec3 N_b = normal;//use this
  vec3 L_b = -L;
  vec3 V_b = -viewDir;
  vec3 H_b = normalize(V_b + L_b);

  vec3 F = SchlickFresnel(F0, max(dot( V_b, normalize(microsurface_normal) ),0.0));
  float G1 = SmithGGXMasking(N_b,V_b,L_b, roughness*roughness);
  float G2 = SmithGGXMaskingShadowing(N_b,V_b,L_b,  roughness*roughness);

  //0.8 is the normalization factor
  vec3 reflectance = F *(G2 / max(G1,0.00001))*0.8;

  accum += lookup2.xyz*reflectance*when_gt(G1,0.000)*when_gt(dot(N_b,L_b),0.00);//*brdfweight;//*NdotL*when_gt(NdotL,0);//*(NdotL)*when_gt(NdotL,0);
  total_weight += 1*when_gt(dot(N_b,L_b),0.00);//brdfweight;//NdotL*when_gt(NdotL,0);

  #else
  NdotL = NdotL*(h2) + (1-h2)*1;
  accum += lookup2.xyz*(NdotL)*when_gt(NdotL,0);
  total_weight += NdotL*when_gt(NdotL,0);
  #endif

  lookup.xyz = (accum)*when_gt(total_weight,0);
  alpha = uintBitsToFloat(packHalf2x16(vec2(dist_to_hit,total_weight)))*h2 + fastNdotL*(1 - h2) ;


  #elif defined(FASTCUBES)
  vec4 lookup = textureLod(reflections,vec4(refnormal*vec3(-1,1,1),index),roughness*4.0);//
  alpha = fastNdotL;
  #else
  float h = raymarch(position,refnormal,reflectionsDepth,index,EnvBoxPos[int(index)].xyz,l,dist_to_hit,synflag);

  vec4 lookup = textureLod(reflections,vec4(l*vec3(-1,1,1),index),roughness*4.0);
  // lookup = vec4(l,0);
  lookup = lookup*h + textureLod(atmosphereCube,(l*vec3(-1,1,1)),roughness*4.0)*(1-h);
  #endif


  return vec4(lookup.xyz*occ,alpha);
}

