vec2 when_ge2(vec2 x, vec2 y) {
  return 1.0 - max(sign(y - x), 0.0);
}
vec3 decodeNormal( vec2 f )
{
    f = f * 2.0 - 1.0;
    vec3 n = vec3( f.x, f.y, 1.0 - abs( f.x ) - abs( f.y ) );
    float t = clamp( -n.z,0,1 );
    n.xy += -sign(when_ge2(n.xy,vec2(0)) - vec2(0.5))*t;
    return normalize( n );
}

vec3 WorldPosFromDepth(vec2 outTexcoord,float depth,out vec4 viewSpacePosition2) {
  float z = depth * 2.0 - 1.0;

  vec4 clipSpacePosition = vec4(outTexcoord * 2.0 - 1.0, z, 1.0);
  vec4 viewSpacePosition = projMatrixInv * clipSpacePosition;

  // Perspective division
  viewSpacePosition /= viewSpacePosition.w;
  viewSpacePosition2 = viewSpacePosition;

  vec4 worldSpacePosition = viewMatrixInv * viewSpacePosition;

  return worldSpacePosition.xyz;
}


float not(float a) {
  return 1.0 - a;
}

float or(float a, float b) {
  return min(a + b, 1.0);
}

float when_eq(float x, float y) {
  return  1- abs(sign(x - y));
}

float when_gt(float x, float y) {
  return max(sign(x - y), 0.0);
}

float when_lt(float x, float y) {
  return max(sign(y - x), 0.0);
}


float when_ge(float x, float y) {
  return 1.0 - max(sign(y - x), 0.0);
}


float distance_squared(vec3 a,vec3 b)
{
  vec3 d = a -b;
  return dot(d,d);
}





float raymarch(vec3 worldspaceRay,vec3 worldSpaceDirection,float cubeindex,vec3 cubepos,out vec3 result,out float dist_to_hit,int iterations,int steps,float synflag)
{
  float REFDEPTH_LEVEL  = LOD_BIAS;//4.0f;

  vec3 worldSpaceRay = worldspaceRay;
  float depth = 0;
  vec3 minp = vec3(worldspaceRay);
  vec3 maxp = vec3(worldspaceRay +worldSpaceDirection*MAX_TRACE );
  float hit = 0;

  float delta = MAX_TRACE/steps;
  //delta*2
  depth += delta*2*synflag;//*synflag;
  //depth += delta; //needed for lower resolution mips
  //constant angle sampling, not used
  // vec3 start = normalize((worldspaceRay +worldSpaceDirection*2 - cubepos));
  // vec3 end = normalize((worldspaceRay +worldSpaceDirection*2000 - cubepos));
  // float theta_total = acos(dot(start,end));
  // float theta_delta = theta_total/steps;



  for (int i = 0; i < steps; i+=4) {

    vec3 p_0 = worldspaceRay + worldSpaceDirection*depth;
    vec3 p_1 = worldspaceRay + worldSpaceDirection*(depth + delta*1);
    vec3 p_2 = worldspaceRay + worldSpaceDirection*(depth + delta*2);
    vec3 p_3 = worldspaceRay + worldSpaceDirection*(depth + delta*3);

    maxp = p_3;
    float dist_0 = textureLod(reflectionsDepth, vec4((p_0 - cubepos)*vec3(-1,1,1),cubeindex),REFDEPTH_LEVEL).r;
    float dist_1 = textureLod(reflectionsDepth, vec4((p_1 - cubepos)*vec3(-1,1,1),cubeindex),REFDEPTH_LEVEL).r;
    float dist_2 = textureLod(reflectionsDepth, vec4((p_2 - cubepos)*vec3(-1,1,1),cubeindex),REFDEPTH_LEVEL).r;
    float dist_3 = textureLod(reflectionsDepth, vec4((p_3 - cubepos)*vec3(-1,1,1),cubeindex),REFDEPTH_LEVEL).r;


    // float cond_0 = when_lt(dist_0*dist_0,distance_squared(p_0,cubepos));
    // float cond_1 = when_lt(dist_1*dist_1,distance_squared(p_1,cubepos));
    // float cond_2 = when_lt(dist_2*dist_2,distance_squared(p_2,cubepos));
    // float cond_3 = when_lt(dist_3*dist_3,distance_squared(p_3,cubepos));
    if (dist_0*dist_0 < distance_squared(p_0,cubepos) || dist_1*dist_1 < distance_squared(p_1,cubepos) || dist_2*dist_2 < distance_squared(p_2,cubepos) || dist_3*dist_3 < distance_squared(p_3,cubepos))
    {
      float d0_hit = when_lt(dist_0*dist_0 , distance_squared(p_0,cubepos));
      float d1_hit = when_lt(dist_1*dist_1 , distance_squared(p_1,cubepos));
      float d2_hit = when_lt(dist_2*dist_2 , distance_squared(p_2,cubepos));
      float d3_hit = when_lt(dist_3*dist_3 , distance_squared(p_3,cubepos));
      maxp = p_0*(d0_hit) + p_1*(d1_hit*(1 - d0_hit)) + p_2*(d2_hit*(1 - d0_hit)*(1 - d1_hit)) + p_3*(d3_hit*(1 - d0_hit)*(1 - d1_hit)*(1 - d2_hit));
      minp = maxp - worldSpaceDirection*(delta);

      hit = 1;
      break;
    }
    minp = p_3;
    depth += delta*4;

    // uint active_threads = subgroupBallotBitCount(subgroupBallot(true));
    // if (active_threads < 16)
    // {
    //   break;
    // }
  }
  //binary search
  //refines by delta*0.5^iterations
  vec3 mid = vec3(0);
  float dist3 = 0;
  float dist2 = 0;
  float d2 = 0;
  if (hit == 1)
  {
    for (int i = 0 ; i < iterations;i++)
    {
      mid = (maxp + minp)*vec3(0.5);
      dist3 = textureLod(reflectionsDepth, vec4((mid - cubepos)*vec3(-1,1,1),cubeindex),REFDEPTH_LEVEL).r;
      float dist2 = dist3*dist3;
      float d2 = distance_squared(mid,cubepos);
      float cmp = when_lt(dist2,d2);

      maxp = maxp*(1-cmp) + cmp*mid;
      minp = mid*(1-cmp) + cmp*minp;

    }
  }

  hit *= 1 - when_gt(abs(dist3 - distance(mid,cubepos)),MAX_TRACE);


  mid = (maxp + minp)*vec3(0.5);
  vec3 intersection = mid;//worldspaceRay + worldSpaceDirection * depth;
  result =  intersection - cubepos;
  float dist = textureLod(reflectionsDepth, vec4((result)*vec3(-1,1,1),cubeindex),REFDEPTH_LEVEL).r;
  hit = hit*when_lt(dist,MAX_TRACE);//when_lt(dist*dist,distance_squared(maxp,cubepos));


  result = result*hit + (1-hit)*worldSpaceDirection;

  dist_to_hit = distance(worldSpaceRay,intersection)*(hit);// + 0*(1-1);
  return hit;
}


float CheckCollision(vec3 pos, vec3 bmin,vec3 bmax)
{
  return when_lt(pos.x,bmax.x)*when_lt(pos.y,bmax.y)*when_lt(pos.z,bmax.z)*when_gt(pos.x,bmin.x)*when_gt(pos.y,bmin.y)*when_gt(pos.z,bmin.z);
}


vec3 fresnelSchlick(float cosTheta, vec3 F0,float roughness)
{
  return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(1.0 - cosTheta, 5.0);
}


float screen2EyeDepth(float depth, float near, float far)
{

    float ndc = 2.0 * depth - 1.0;
    float eye = 2.0 * far * near / (far + near + ndc * (near - far));
    return eye;
}

