#version 450 core
layout(vertices = 3) out;
in vec3 vPosition[];
in vec2 vTexCoord[];
in vec3 vNormal[];
in mat4 vTransform[];
in vec2 vID[];

out vec3 tcPosition[];
out vec2 tcTexCoord[];
out vec3 tcNormal[];
out mat4 tcTransform[];
out vec2 tcID[];


#define ID gl_InvocationID



void main()
{
  tcPosition[ID] = vPosition[ID];
  tcTexCoord[ID] = vTexCoord[ID];
  tcNormal[ID] = vNormal[ID];
  tcTransform[ID] = vTransform[ID];
  tcID[ID] = vID[ID];

  gl_TessLevelInner[0] = 3;
  gl_TessLevelOuter[1] = 3;
  gl_TessLevelOuter[2] = 3;
  gl_TessLevelOuter[3] = 3;
}
